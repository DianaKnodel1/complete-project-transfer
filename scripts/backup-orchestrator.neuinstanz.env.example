# Vorlage für die NEUE Instanz (Hauptserver 190.97.165.55, Backup-Server 190.97.165.56).
# Auf dem Backup-Server kopieren nach scripts/backup-orchestrator.env und ausfüllen.
BACKUP_DIR=/var/backups/portal
DB_HOST=190.97.165.55
DB_CONTAINER=supabase-db
SUPABASE_DIR=/opt/supabase
# Portal und WebID liegen auf demselben Hauptserver
SERVER_PORTAL_HOST=190.97.165.55
SERVER_LANDING_HOST=
SERVER_LANDING_DIR=/opt/landing-server
SERVER_BOT_HOST=
SERVER_WEBID_HOST=190.97.165.55
BACKUP_RETENTION_DAYS=14
BACKUP_MONTHLY_RETENTION_DAYS=92
# age-keygen -o key.txt  → öffentlichen Schlüssel (age1...) hier eintragen
AGE_PUBLIC_KEY=
# Leere Instanz: Archiv ist anfangs klein, Grenzen daher niedrig
MIN_ARCHIVE_MB=1
MIN_PUBLIC_TABLES=20
MAX_BACKUP_AGE_HOURS=30
DISK_ALERT_PERCENT=80
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_EMAIL=
OFFSITE_RSYNC_TARGET=
OFFSITE_SSH_OPTS=
